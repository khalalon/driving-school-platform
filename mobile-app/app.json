{
  "expo": {
    "name": "DrivingSchoolApp",
    "slug": "driving-school-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drivingschool.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E42C4"
      },
      "package": "com.drivingschool.app"
    },
    "extra": {
      "API_BASE_URL": "http://10.0.2.2:80"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF7",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#11151F"
          }
        }
      ],
      "expo-font",
      "expo-localization"
    ]
  }
}
