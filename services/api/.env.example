# Application unique (services/api). Toutes les variables sont validées au démarrage (src/config/env.ts).
NODE_ENV=development
PORT=3000

# Obligatoires
DATABASE_URL=postgresql://admin:password@localhost:5433/driving_school
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-secret-at-least-32-characters-long

# Facultatives (défauts entre parenthèses)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
