# Application unique (services/api). Toutes les variables sont validées au démarrage (src/config/env.ts).
NODE_ENV=development
PORT=3000

# Obligatoires
DATABASE_URL=postgresql://admin:password@localhost:5433/driving_school
REDIS_URL=redis://localhost:6379
# Deux secrets distincts, 32 caractères minimum (D-12) : openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-chars

# Facultatives (défauts entre parenthèses) — durées D-23
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
