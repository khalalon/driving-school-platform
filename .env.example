# Variables lues par docker-compose.yml (copier en .env ; .env est ignoré par git).

# Environment
NODE_ENV=production

# Database (POSTGRES_PORT = port publié sur la machine hôte ; 5433 si 5432 est déjà pris)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=driving_school
POSTGRES_PORT=5432

# Redis (port publié sur la machine hôte)
REDIS_PORT=6379

# API (services/api) — JWT_SECRET : 16 caractères minimum, obligatoire
JWT_SECRET=change-this-super-secret-jwt-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
