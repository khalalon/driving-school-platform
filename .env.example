# Variables lues par docker-compose.yml (copier en .env ; .env est ignoré par git).

# Environment
NODE_ENV=production

# Database (POSTGRES_PORT = port publié sur la machine hôte ; 5433 si 5432 est déjà pris)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=driving_school
POSTGRES_PORT=5432

# Redis (port publié sur la machine hôte)
REDIS_PORT=6379

# API (services/api) — deux secrets JWT distincts, 32 caractères minimum, obligatoires (D-12) :
# sans eux, docker compose refuse de démarrer l'API. Générer : openssl rand -hex 32
JWT_ACCESS_SECRET=change-this-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-chars
# Durées (D-23) : access 1 h, refresh 30 j
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
